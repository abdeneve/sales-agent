# =========================================================
# Agente de Atendimento e Vendas — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# =========================================================

# --- Banco de Dados ---
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=sales_agent_secret
POSTGRES_DB=sales_agent_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=changeme_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- EvolutionAPI ---
EVOLUTION_PORT=8080
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_api_key
# URL que a EvolutionAPI vai chamar quando receber msgs do WhatsApp
WEBHOOK_URL=http://backend:8000/webhooks/evolution

